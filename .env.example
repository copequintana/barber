# PostgreSQL — en dev: contenedor Docker local
#   docker run -d --name barberdesk-pg -e POSTGRES_USER=barberdesk -e POSTGRES_PASSWORD=barberdesk -e POSTGRES_DB=barberdesk -p 5433:5432 postgres:16
#   luego: npm run db:init  (crea el rol de app sin privilegios, sujeto a RLS)

# Conexión de la APP (rol sin privilegios; RLS activo)
DATABASE_URL="postgresql://barberdesk_app:barberdesk_app@localhost:5433/barberdesk?schema=public"
# Conexión para MIGRACIONES (rol dueño del esquema)
MIGRATE_DATABASE_URL="postgresql://barberdesk:barberdesk@localhost:5433/barberdesk?schema=public"

# ⚠️ En Neon (o cualquier Postgres gestionado): el rol "owner" del proyecto
# suele tener BYPASSRLS — con ese rol, TODAS las políticas de RLS quedan
# inertes y cualquier tenant puede leer los datos de cualquier otro, sin
# ningún error ni aviso. DATABASE_URL en producción DEBE ser un rol aparte,
# sin privilegios (igual que barberdesk_app aquí), NUNCA el mismo que
# MIGRATE_DATABASE_URL. Verificar con:
#   SELECT rolname, rolbypassrls FROM pg_roles WHERE rolname = current_user;
# (rolbypassrls debe ser false para el rol de DATABASE_URL)

# Better Auth (email+contraseña). Genera un secreto propio: 32 bytes aleatorios
# en base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET="cambiame"
# URL pública de la app. En Vercel puede omitirse: se usa
# VERCEL_PROJECT_PRODUCTION_URL como respaldo.
# BETTER_AUTH_URL="https://tudominio.com"
# Registro público: abierto salvo que valga exactamente "false". Ciérralo en
# producción cuando ya existan las cuentas necesarias.
# ALLOW_SIGNUP=false

# Emails transaccionales (T12). Sin RESEND_API_KEY los emails se imprimen en
# el log del servidor (transporte de desarrollo).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="BarberDesk <citas@tudominio.com>"
# URL base para los links de los emails
APP_URL="http://localhost:3000"

# Cron (T13): protege /api/cron/reminders; correr local: npm run cron
# CRON_SECRET="algo-aleatorio"

# WhatsApp Cloud API (T13). Sin credenciales, transporte de desarrollo por consola.
# El tenant ademas debe tener whatsapp_enabled=true.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# WHATSAPP_TEMPLATE="recordatorio_cita"

# Consola de plataforma (T20): emails con acceso super-admin (ademas del flag
# is_platform_admin en la tabla users)
# PLATFORM_ADMIN_EMAILS="tu@email.com"
